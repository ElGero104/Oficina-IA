# Clave de API de Mistral (obligatoria). La creas en https://console.mistral.ai/
MISTRAL_API_KEY=

# Contraseña única de acceso a la oficina (obligatoria).
# El servidor deriva de ella la clave de firma de la cookie de sesión.
APP_PASSWORD=

# Tope diario de llamadas a la API de Mistral (opcional, por defecto 200).
# Vive en memoria: se reinicia cuando el servicio reinicia (plan gratuito de Render).
MAX_AI_CALLS_PER_DAY=
